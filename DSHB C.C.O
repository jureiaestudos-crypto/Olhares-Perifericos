2. OBJETIVOS ALCANÇADOS
────────────────────────────────────────────────────────
[x] Produção e publicação do livro "Caminhando com Orí"
[x] Distribuição de 30% dos exemplares em 3 pontos estratégicos
[x] Realização do evento de lançamento
[x] Disponibilização do áudio livro (acessibilidade)
[ ] (Preencher conforme execução)

3. PÚBLICO ALCANÇADO
────────────────────────────────────────────────────────
Meta: 100 pessoas | Realizado: _____ pessoas

Ponto 1 — Morro do Saboó:       _____ pessoas
Ponto 2 — Vila Gilda / ZNO:     _____ pessoas
Ponto 3 — Vila Nova-Paquetá:    _____ pessoas
Evento de lançamento:           _____ pessoas

4. EXECUÇÃO FINANCEIRA FINAL
────────────────────────────────────────────────────────
Total aprovado:         R$ 20.000,00
Total executado:        R$ ________
Saldo devolvido:        R$ ________
% executado:            _______%

5. EVIDÊNCIAS E REGISTROS
────────────────────────────────────────────────────────
• Listas de presença dos 3 encontros: [ ] Anexadas
• Registros fotográficos:             [ ] Anexados
• Notas fiscais e recibos:            [ ] Organizados
• Relatório de redes sociais:         [ ] Anexado
• Exemplares do livro:                [ ] Fotografados

════════════════════════════════════════════════════════
Santos, ______________________

Nicolle de Barros Corratti Tibiriçá Dias
Proponente — Caminhando com Orí
════════════════════════════════════════════════════════`;
  }

  document.getElementById('relatorio-output').textContent = txt;
  document.getElementById('rel-hint').textContent = '✓ Relatório gerado · ' + hoje;
}

// ─── ACTIONS ─────────────────────────────────────────────────────────
function toggleTarefa(id) {
  state.tarefas[id] = !state.tarefas[id];
  renderTarefas();
  renderOverview();
  updateSidebar();
}

function toggleFase(fase) {
  if(state.openFases.has(fase)) state.openFases.delete(fase);
  else state.openFases.add(fase);
  renderTarefas();
}

function expandAll() {
  TAREFAS.forEach(f => state.openFases.add(f.fase));
  renderTarefas();
}

function collapseAll() {
  state.openFases.clear();
  renderTarefas();
}

function toggleNfPago(i) {
  state.nfPago[i] = !state.nfPago[i];
  renderFinanceiro();
}

function toggleNfArq(i) {
  state.nfArq[i] = !state.nfArq[i];
  renderFinanceiro();
}

function toggleDist(i) {
  DISTRIBUICAO[i].done = !DISTRIBUICAO[i].done;
  renderDistribuicao();
}

function setRelTipo(tipo) {
  state.relTipo = tipo;
  document.querySelectorAll('#rel-tabs .tab').forEach((el,i)=>{
    el.classList.toggle('active', ['parcial','final','reuniao'][i]===tipo);
  });
  document.getElementById('rel-hint').textContent = 'Tipo selecionado: ' + tipo;
}

function copiarRelatorio() {
  const txt = document.getElementById('relatorio-output').textContent;
  navigator.clipboard.writeText(txt).then(()=>{
    document.getElementById('rel-hint').textContent = '✓ Copiado para a área de transferência!';
  });
}

function imprimirRelatorio() { window.print(); }

function updateSidebar() {
  const prog = calcProgress();
  const sbFill = document.getElementById('sb-fill');
  const sbPct  = document.getElementById('sb-pct');
  if(sbFill) sbFill.style.width = prog.pct+'%';
  if(sbPct)  sbPct.textContent  = prog.pct+'%';
}

// ─── NAVIGATION ──────────────────────────────────────────────────────
const VIEW_TITLES = {
  overview:      'Visão Geral',
  tarefas:       'Plano de Tarefas',
  financeiro:    'Financeiro & Notas Fiscais',
  equipe:        'Equipe Técnica',
  distribuicao:  'Distribuição Gratuita',
  relatorio:     'Gerador de Relatório',
  atualizacoes:  'Atualizações do Projeto',
};

function showView(name) {
  document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));

  const v = document.getElementById('view-'+name);
  if(v) v.classList.add('active');

  const navItems = document.querySelectorAll('.nav-item');
  const idx = ['overview','tarefas','financeiro','equipe','distribuicao','relatorio','atualizacoes'].indexOf(name);
  if(navItems[idx]) navItems[idx].classList.add('active');

  const tt = document.getElementById('topbar-title');
  if(tt) tt.textContent = VIEW_TITLES[name] || name;

  if(name==='tarefas')       renderTarefas();
  if(name==='financeiro')    renderFinanceiro();
  if(name==='equipe')        renderEquipe();
  if(name==='distribuicao')  renderDistribuicao();
  if(name==='overview')      renderOverview();
  if(name==='atualizacoes')  { preencherDataHoje(); renderAtualizacoes(); }
}

// ─── INIT ─────────────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', ()=>{
  const dateEl = document.getElementById('topbar-date');
  const now = new Date();
  if(dateEl) dateEl.textContent = now.toLocaleDateString('pt-BR',{weekday:'long',day:'2-digit',month:'long',year:'numeric'});

  renderOverview();
  updateSidebar();
  carregarAtualizacoes();
});

// ─── ATUALIZAÇÕES ─────────────────────────────────────────────────────

const UPD_TIPOS = {
  info:       { icon:'ℹ', cor:'#1A4A7A', bg:'#EBF3FB', label:'Progresso' },
  ok:         { icon:'✓', cor:'#1A5C38', bg:'#E3F2E9', label:'Concluído' },
  alerta:     { icon:'⚑', cor:'#C8871A', bg:'#FDF3DC', label:'Alerta' },
  financeiro: { icon:'R$', cor:'#5A3A7A', bg:'#F3EEF9', label:'Financeiro' },
  reuniao:    { icon:'◎', cor:'#5C4A28', bg:'#F5EFE2', label:'Reunião' },
  problema:   { icon:'✕', cor:'#9B2226', bg:'#FFF0F0', label:'Problema' },
};

const UPD_CATS = {
  Producao:      { cor:'#1A5C38' },
  Financeiro:    { cor:'#5A3A7A' },
  Divulgacao:    { cor:'#5A3A7A' },
  Reuniao:       { cor:'#5C4A28' },
  Grafica:       { cor:'#1A4A7A' },
  Distribuicao:  { cor:'#C8871A' },
  Lancamento:    { cor:'#C8871A' },
  Administrativo:{ cor:'#777' },
  Outro:         { cor:'#777' },
};

// Guarda atualizações em memória (persiste enquanto a aba estiver aberta)
// Para persistência real, troque por localStorage se o ambiente suportar
let ATUALIZACOES = [
  {
    id: 1,
    data: '2025-08-04',
    titulo: 'Início do projeto — reunião de equipe',
    desc: 'Primeira reunião geral. Alinhamento de papeis, definição da estrutura do livro e início dos contatos com prestadores e fornecedores.',
    resp: 'Equipe',
    cat: 'Reuniao',
    tipo: 'reuniao',
  },
  {
    id: 2,
    data: '2025-08-22',
    titulo: 'Pagamento da guia do ISBN realizado',
    desc: 'Taxa de registro do livro na Biblioteca Nacional quitada. Número ISBN em processamento.',
    resp: 'Nicolle',
    cat: 'Administrativo',
    tipo: 'financeiro',
  },
  {
    id: 3,
    data: '2026-03-13',
    titulo: 'Aprovação do planejamento de divulgação',
    desc: 'Reunião de equipe realizada. Planejamento de divulgação aprovado. Saldo em caixa: R$ 5.800,00. ISBN aguardando confirmação para fechamento do arquivo.',
    resp: 'Equipe',
    cat: 'Reuniao',
    tipo: 'reuniao',
  },
];

let proximoId = 4;

function carregarAtualizacoes() {
  // Ponto de extensão: aqui você pode ler de localStorage ou outra fonte
  renderAtualizacoes();
}

function preencherDataHoje() {
  const el = document.getElementById('upd-data');
  if(el && !el.value) {
    const now = new Date();
    const y = now.getFullYear();
    const m = String(now.getMonth()+1).padStart(2,'0');
    const d = String(now.getDate()).padStart(2,'0');
    el.value = `${y}-${m}-${d}`;
  }
}

function salvarAtualizacao() {
  const data    = document.getElementById('upd-data').value;
  const titulo  = document.getElementById('upd-titulo').value.trim();
  const desc    = document.getElementById('upd-desc').value.trim();
  const resp    = document.getElementById('upd-resp').value;
  const cat     = document.getElementById('upd-cat').value;
  const tipo    = document.getElementById('upd-tipo').value;

  if(!titulo) {
    document.getElementById('upd-feedback').textContent = '⚠ Preencha o título.';
    document.getElementById('upd-feedback').style.color = 'var(--red)';
    return;
  }
  if(!data) {
    document.getElementById('upd-feedback').textContent = '⚠ Preencha a data.';
    document.getElementById('upd-feedback').style.color = 'var(--red)';
    return;
  }

  ATUALIZACOES.unshift({ id: proximoId++, data, titulo, desc, resp, cat, tipo });
  renderAtualizacoes();
  limparFormulario();

  const fb = document.getElementById('upd-feedback');
  fb.textContent = '✓ Atualização registrada!';
  fb.style.color = 'var(--verde)';
  setTimeout(()=>{ fb.textContent = ''; }, 3000);
}

function limparFormulario() {
  document.getElementById('upd-titulo').value = '';
  document.getElementById('upd-desc').value   = '';
  document.getElementById('upd-resp').value   = 'Equipe';
  document.getElementById('upd-cat').value    = 'Producao';
  document.getElementById('upd-tipo').value   = 'info';
  preencherDataHoje();
}

function deletarAtualizacao(id) {
  if(!confirm('Remover esta atualização?')) return;
  ATUALIZACOES = ATUALIZACOES.filter(u => u.id !== id);
  renderAtualizacoes();
}

function editarAtualizacao(id) {
  const upd = ATUALIZACOES.find(u => u.id === id);
  if(!upd) return;
  document.getElementById('upd-data').value   = upd.data;
  document.getElementById('upd-titulo').value = upd.titulo;
  document.getElementById('upd-desc').value   = upd.desc;
  document.getElementById('upd-resp').value   = upd.resp;
  document.getElementById('upd-cat').value    = upd.cat;
  document.getElementById('upd-tipo').value   = upd.tipo;
  // Remove o original para reeditar
  ATUALIZACOES = ATUALIZACOES.filter(u => u.id !== id);
  renderAtualizacoes();
  document.getElementById('upd-titulo').focus();
  document.getElementById('upd-feedback').textContent = '✏ Editando — clique em Registrar para salvar.';
  document.getElementById('upd-feedback').style.color = 'var(--gold)';
  window.scrollTo(0,0);
}

function formatarData(str) {
  if(!str) return '—';
  const [y,m,d] = str.split('-');
  const meses = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
  return `${d} ${meses[parseInt(m,10)-1]} ${y}`;
}

function renderAtualizacoes() {
  const lista  = document.getElementById('upd-lista');
  const countEl= document.getElementById('upd-count');
  if(!lista) return;

  const busca  = (document.getElementById('upd-busca')?.value || '').toLowerCase();
  const filtCat= document.getElementById('upd-filtro-cat')?.value || '';

  const filtradas = ATUALIZACOES
    .filter(u => {
      const matchCat  = !filtCat || u.cat === filtCat;
      const matchText = !busca   || u.titulo.toLowerCase().includes(busca) || (u.desc||'').toLowerCase().includes(busca);
      return matchCat && matchText;
    })
    .sort((a,b) => b.data.localeCompare(a.data));

  if(countEl) countEl.textContent = `(${filtradas.length} registro${filtradas.length!==1?'s':''})`;

  if(filtradas.length === 0) {
    lista.innerHTML = `
      <div style="text-align:center;padding:48px 20px;color:var(--ink3)">
        <div style="font-size:32px;margin-bottom:12px;opacity:.4">◎</div>
        <p style="font-size:13px">${ATUALIZACOES.length===0?'Nenhuma atualização registrada ainda.':'Nenhum resultado para o filtro aplicado.'}</p>
      </div>`;
    return;
  }

  // Agrupar por mês/ano
  const grupos = {};
  filtradas.forEach(u => {
    const key = u.data.slice(0,7); // yyyy-mm
    if(!grupos[key]) grupos[key] = [];
    grupos[key].push(u);
  });

  const mesesNome = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];

  lista.innerHTML = Object.keys(grupos).sort((a,b)=>b.localeCompare(a)).map(key => {
    const [y,m] = key.split('-');
    const mesLabel = `${mesesNome[parseInt(m,10)-1]} / ${y}`;
    const itens = grupos[key];
    return `
      <div style="margin-bottom:24px">
        <div style="font-family:var(--ff-head);font-size:13px;font-weight:700;color:var(--ink3);
          text-transform:uppercase;letter-spacing:.08em;padding:6px 0;
          border-bottom:1px solid var(--border);margin-bottom:10px">
          ${mesLabel}
        </div>
        ${itens.map(u => {
          const tp = UPD_TIPOS[u.tipo] || UPD_TIPOS.info;
          const mc = MEMBROS[u.resp] || MEMBROS.Equipe;
          const cc = UPD_CATS[u.cat] || { cor:'#777' };
          return `
            <div style="display:flex;gap:14px;padding:14px 16px;background:var(--white);
              border:1px solid var(--border);border-radius:var(--radius);
              margin-bottom:8px;transition:box-shadow .15s;border-left:4px solid ${tp.cor}"
              onmouseover="this.style.boxShadow='0 3px 12px rgba(0,0,0,.07)'"
              onmouseout="this.style.boxShadow='none'">
              <!-- Ícone tipo -->
              <div style="width:32px;height:32px;border-radius:50%;background:${tp.bg};
                display:flex;align-items:center;justify-content:center;
                font-size:13px;font-weight:700;color:${tp.cor};flex-shrink:0;margin-top:1px">
                ${tp.icon}
              </div>
              <!-- Corpo -->
              <div style="flex:1;min-width:0">
                <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:3px">
                  <div style="font-size:13.5px;font-weight:500;color:var(--ink)">${u.titulo}</div>
                  <div style="display:flex;gap:6px;align-items:center;flex-shrink:0">
                    <button onclick="editarAtualizacao(${u.id})" title="Editar"
                      style="border:none;background:none;cursor:pointer;color:var(--ink3);font-size:12px;padding:2px 4px;border-radius:3px"
                      onmouseover="this.style.background='var(--cream2)'" onmouseout="this.style.background='none'">✏</button>
                    <button onclick="deletarAtualizacao(${u.id})" title="Remover"
                      style="border:none;background:none;cursor:pointer;color:var(--ink3);font-size:12px;padding:2px 4px;border-radius:3px"
                      onmouseover="this.style.background='var(--red-lt)';this.style.color='var(--red)'"
                      onmouseout="this.style.background='none';this.style.color='var(--ink3)'">✕</button>
                  </div>
                </div>
                <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:${u.desc?'8px':'0'}">
                  <span style="font-size:11px;color:var(--ink3)">${formatarData(u.data)}</span>
                  <span style="font-size:10px;padding:1px 7px;border-radius:10px;font-weight:500;
                    background:${mc.bg};color:${mc.color}">${u.resp}</span>
                  <span style="font-size:10px;padding:1px 7px;border-radius:10px;font-weight:500;
                    background:${tp.bg};color:${tp.cor}">${tp.label}</span>
                  <span style="font-size:10px;padding:1px 7px;border-radius:10px;
                    background:var(--cream2);color:${cc.cor};border:1px solid var(--border)">${u.cat}</span>
                </div>
                ${u.desc ? `<div style="font-size:12.5px;color:var(--ink2);line-height:1.6;
                  background:var(--cream);padding:8px 10px;border-radius:5px;border-left:2px solid var(--border)">${u.desc.replace(/\n/g,'<br>')}</div>` : ''}
              </div>
            </div>
          `;
        }).join('')}
      </div>
    `;
  }).join('');
}

function exportarAtualizacoes() {
  const linhas = ['DATA\tTITULO\tDESCRICAO\tRESPONSAVEL\tCATEGORIA\tTIPO'];
  ATUALIZACOES
    .sort((a,b)=>b.data.localeCompare(a.data))
    .forEach(u => {
      linhas.push([u.data, u.titulo, (u.desc||'').replace(/\n/g,' '), u.resp, u.cat, u.tipo].join('\t'));
    });
  const blob = new Blob([linhas.join('\n')], { type:'text/plain;charset=utf-8' });
  const url  = URL.createObjectURL(blob);
  const a    = document.createElement('a');
  a.href = url; a.download = 'atualizacoes_ori.txt';
  a.click(); URL.revokeObjectURL(url);
}
</script>
</body>
</html>

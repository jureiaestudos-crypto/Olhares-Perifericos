<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Caminhando com Ori — Dashboard</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,700;1,500&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}

:root{
  --gold:    #C8871A;
  --gold2:   #E8A82A;
  --gold-lt: #FDF3DC;
  --gold-md: #F5D68A;
  --verde:   #1A5C38;
  --verde2:  #2E7D52;
  --verde-lt:#E3F2E9;
  --terra:   #7A3520;
  --terra-lt:#F5EAE4;
  --azul:    #1A3A6A;
  --azul-lt: #E6EDF8;
  --night:   #1A1208;
  --night2:  #2C2010;
  --ink:     #241A08;
  --ink2:    #5C4A28;
  --ink3:    #9C8464;
  --cream:   #FDF8F0;
  --cream2:  #F5EFE2;
  --cream3:  #EDE4D0;
  --border:  #DDD0B8;
  --white:   #FFFFFF;
  --red:     #9B2226;
  --red-lt:  #FFF0F0;
  --ff-head: 'Playfair Display', Georgia, serif;
  --ff-body: 'DM Sans', system-ui, sans-serif;
  --radius:  12px;
  --radius-sm: 6px;
}

body{
  font-family:var(--ff-body);
  background:var(--cream);
  color:var(--ink);
  min-height:100vh;
  font-size:14px;
  line-height:1.6;
}

/* LAYOUT */
.shell{display:flex;min-height:100vh}

/* SIDEBAR */
.sidebar{
  width:220px;flex-shrink:0;
  background:var(--night);
  display:flex;flex-direction:column;
  padding:0 0 24px;
  position:sticky;top:0;height:100vh;
  overflow:hidden;
}
.sidebar-brand{
  padding:28px 20px 20px;
  border-bottom:1px solid rgba(200,135,26,0.2);
  margin-bottom:12px;
}
.sidebar-brand .ori{
  font-family:var(--ff-head);
  font-size:13px;
  color:var(--gold);
  letter-spacing:.12em;
  text-transform:uppercase;
  display:block;
  margin-bottom:2px;
}
.sidebar-brand h1{
  font-family:var(--ff-head);
  font-size:18px;
  color:#FDF8F0;
  line-height:1.2;
  font-weight:700;
}
.sidebar-brand p{
  font-size:10px;color:rgba(253,248,240,.4);
  margin-top:4px;letter-spacing:.04em;
}
.nav-section{
  font-size:9px;letter-spacing:.12em;text-transform:uppercase;
  color:rgba(253,248,240,.3);padding:10px 20px 4px;
}
.nav-item{
  display:flex;align-items:center;gap:10px;
  padding:9px 20px;cursor:pointer;
  color:rgba(253,248,240,.55);font-size:12.5px;
  border-left:3px solid transparent;
  transition:all .15s;
}
.nav-item:hover{color:#FDF8F0;background:rgba(200,135,26,.08)}
.nav-item.active{
  color:#FDF8F0;border-left-color:var(--gold);
  background:rgba(200,135,26,.12);
}
.nav-dot{
  width:6px;height:6px;border-radius:50%;
  background:rgba(253,248,240,.3);flex-shrink:0;
}
.nav-item.active .nav-dot{background:var(--gold)}
.sidebar-footer{
  margin-top:auto;padding:16px 20px 0;
  border-top:1px solid rgba(200,135,26,.15);
  font-size:10px;color:rgba(253,248,240,.3);line-height:1.6;
}
.sidebar-progress{
  padding:0 20px;margin-top:16px;
}
.sidebar-progress label{
  font-size:10px;color:rgba(253,248,240,.4);
  display:flex;justify-content:space-between;margin-bottom:6px;
}
.sp-bar{height:4px;background:rgba(255,255,255,.1);border-radius:2px;overflow:hidden}
.sp-fill{height:100%;background:var(--gold);border-radius:2px;transition:width .4s}

/* MAIN */
.main{flex:1;overflow-y:auto}

/* TOPBAR */
.topbar{
  display:flex;align-items:center;justify-content:space-between;
  padding:16px 32px;
  background:var(--white);
  border-bottom:1px solid var(--border);
  position:sticky;top:0;z-index:20;
}
.topbar-left{display:flex;align-items:center;gap:12px}
.topbar-title{font-family:var(--ff-head);font-size:20px;font-weight:700}
.topbar-sub{font-size:12px;color:var(--ink3)}
.topbar-right{display:flex;align-items:center;gap:10px}
.badge{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:20px;font-size:11px;font-weight:500}
.badge-gold{background:var(--gold-lt);color:var(--gold)}
.badge-verde{background:var(--verde-lt);color:var(--verde)}
.badge-red{background:var(--red-lt);color:var(--red)}
.badge-azul{background:var(--azul-lt);color:var(--azul)}

/* CONTENT */
.content{padding:28px 32px;max-width:1200px}

/* BTN */
.btn{
  display:inline-flex;align-items:center;gap:6px;
  padding:9px 18px;border-radius:var(--radius-sm);
  font-family:var(--ff-body);font-size:12.5px;font-weight:500;
  cursor:pointer;border:none;transition:all .15s;
}
.btn-gold{background:var(--gold);color:#FDF8F0}
.btn-gold:hover{background:#B07010}
.btn-ghost{background:transparent;color:var(--ink);border:1px solid var(--border)}
.btn-ghost:hover{background:var(--cream2)}
.btn-dark{background:var(--night);color:var(--cream)}
.btn-dark:hover{background:var(--night2)}
.btn-sm{padding:6px 12px;font-size:11.5px}
.btn-verde{background:var(--verde);color:white}
.btn-verde:hover{background:var(--verde2)}

/* SECTIONS */
.section-title{
  font-family:var(--ff-head);
  font-size:18px;font-weight:700;
  margin-bottom:14px;padding-bottom:10px;
  border-bottom:2px solid var(--gold);
  display:flex;align-items:center;justify-content:space-between;
}

/* KPI GRID */
.kpi-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:28px}
.kpi-card{
  background:var(--white);border:1px solid var(--border);
  border-radius:var(--radius);padding:18px 18px 14px;
  border-top:3px solid var(--kpi-color,var(--gold));
  position:relative;overflow:hidden;
}
.kpi-card::after{
  content:attr(data-icon);
  position:absolute;right:14px;top:14px;
  font-size:22px;opacity:.15;
}
.kpi-label{font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink3);margin-bottom:6px}
.kpi-value{font-family:var(--ff-head);font-size:26px;font-weight:700;line-height:1;color:var(--kpi-color,var(--ink))}
.kpi-sub{font-size:11px;color:var(--ink3);margin-top:4px}

/* FASES */
.fases-row{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:28px}
.fase-card{
  border:1px solid var(--border);border-radius:var(--radius);
  padding:16px;cursor:pointer;transition:all .18s;
  background:var(--white);position:relative;overflow:hidden;
}
.fase-card::before{
  content:'';position:absolute;top:0;left:0;right:0;height:3px;
  background:var(--fase-color);
}
.fase-card:hover{transform:translateY(-2px);box-shadow:0 6px 24px rgba(0,0,0,.08)}
.fase-card.active{border-color:var(--fase-color);box-shadow:0 0 0 2px var(--fase-color)30}
.fase-num{
  width:24px;height:24px;border-radius:50%;
  background:var(--fase-color);color:white;
  display:flex;align-items:center;justify-content:center;
  font-size:11px;font-weight:500;margin-bottom:8px;
}
.fase-name{font-size:12px;font-weight:500;margin-bottom:2px}
.fase-period{font-size:10px;color:var(--ink3)}
.fase-bar{height:3px;background:var(--cream3);border-radius:2px;margin-top:10px;overflow:hidden}
.fase-bar-fill{height:100%;border-radius:2px;background:var(--fase-color);transition:width .4s}
.fase-pct{font-size:10px;color:var(--ink3);text-align:right;margin-top:4px}

/* GRID DE CONTEÚDO */
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:28px}
.one-col{margin-bottom:28px}
.card{
  background:var(--white);border:1px solid var(--border);
  border-radius:var(--radius);padding:20px 22px;
}

/* TAREFAS */
.tarefa-grupo{margin-bottom:4px}
.tarefa-fase-hdr{
  display:flex;align-items:center;justify-content:space-between;
  padding:10px 14px;border-radius:var(--radius-sm);
  cursor:pointer;margin-bottom:2px;
  background:var(--cream2);
  border:1px solid var(--border);
  user-select:none;
  transition:background .12s;
}
.tarefa-fase-hdr:hover{background:var(--cream3)}
.tarefa-fase-hdr.open{border-radius:var(--radius-sm) var(--radius-sm) 0 0;border-bottom:none}
.tarefa-fase-title{display:flex;align-items:center;gap:8px;font-size:12.5px;font-weight:500}
.tarefa-fase-dot{width:8px;height:8px;border-radius:50%}
.tarefa-fase-meta{font-size:11px;color:var(--ink3)}
.tarefa-list{
  border:1px solid var(--border);border-top:none;
  border-radius:0 0 var(--radius-sm) var(--radius-sm);
  margin-bottom:8px;overflow:hidden;display:none;
}
.tarefa-list.open{display:block}
.tarefa-item{
  display:flex;align-items:flex-start;gap:10px;
  padding:9px 14px;border-bottom:1px solid var(--cream3);
  transition:background .1s;
}
.tarefa-item:last-child{border-bottom:none}
.tarefa-item:hover{background:var(--cream2)}
.tarefa-item.done{opacity:.55}
.tarefa-item.done .tarefa-text{text-decoration:line-through;color:var(--ink3)}
.tarefa-cb{
  width:16px;height:16px;border-radius:3px;
  border:1.5px solid var(--border);background:var(--white);
  cursor:pointer;flex-shrink:0;margin-top:2px;
  display:flex;align-items:center;justify-content:center;
  font-size:10px;transition:all .15s;
}
.tarefa-cb.done{background:var(--verde);border-color:var(--verde);color:white}
.tarefa-text{font-size:12.5px;flex:1}
.tarefa-resp{
  font-size:10px;padding:2px 7px;border-radius:10px;flex-shrink:0;
  font-weight:500;
}

/* FINANCEIRO */
.fin-table{width:100%;border-collapse:collapse;font-size:12.5px}
.fin-table th{
  background:var(--night);color:var(--gold-md);
  padding:8px 10px;text-align:left;font-weight:500;
  font-size:11px;letter-spacing:.04em;
}
.fin-table th:last-child,.fin-table td:last-child{text-align:center}
.fin-table td{padding:8px 10px;border-bottom:1px solid var(--cream3)}
.fin-table tr:hover td{background:var(--cream2)}
.fin-table tr.pago td{background:rgba(26,92,56,.04)}
.fin-status{
  display:inline-flex;align-items:center;
  padding:2px 8px;border-radius:10px;font-size:11px;font-weight:500;
}
.fin-status.pago{background:var(--verde-lt);color:var(--verde)}
.fin-status.pendente{background:var(--gold-lt);color:var(--gold)}
.fin-status.definir{background:var(--cream3);color:var(--ink3)}
.nf-cb{
  width:16px;height:16px;border-radius:3px;
  border:1.5px solid var(--border);
  cursor:pointer;display:inline-flex;align-items:center;justify-content:center;
  font-size:10px;transition:all .15s;background:white;
}
.nf-cb.done{background:var(--verde);border-color:var(--verde);color:white}

/* EQUIPE */
.equipe-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
.membro-card{
  border:1px solid var(--border);border-radius:var(--radius);
  padding:14px 16px;background:var(--white);
}
.membro-top{display:flex;align-items:center;gap:10px;margin-bottom:10px}
.avatar{
  width:38px;height:38px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  font-size:13px;font-weight:500;flex-shrink:0;
}
.membro-name{font-size:13.5px;font-weight:500}
.membro-role{font-size:11px;color:var(--ink3)}
.membro-tasks{font-size:11.5px;color:var(--ink2);line-height:1.5}

/* DISTRIBUICAO */
.dist-card{
  border-radius:var(--radius);padding:14px 16px;
  border:1px solid var(--border);background:var(--white);
  margin-bottom:10px;
}
.dist-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:6px}
.dist-name{font-size:13.5px;font-weight:500}
.dist-meta{font-size:11.5px;color:var(--ink3);margin-top:2px}
.dist-progress{height:4px;background:var(--cream3);border-radius:2px;overflow:hidden;margin-top:10px}
.dist-fill{height:100%;background:var(--gold);border-radius:2px;transition:width .3s}

/* RELATORIO */
#relatorio-output{
  background:var(--cream);border:1px solid var(--border);
  border-radius:var(--radius-sm);padding:20px;
  font-size:12px;line-height:1.8;
  white-space:pre-wrap;max-height:500px;overflow-y:auto;
  display:none;
  font-family:'Georgia',serif;
}

/* CRONOGRAMA VISUAL */
.timeline{position:relative;padding-left:0;margin:0}
.timeline-item{
  display:grid;grid-template-columns:120px 20px 1fr;
  gap:0 12px;align-items:start;margin-bottom:0;
  position:relative;
}
.timeline-date{
  text-align:right;font-size:11px;color:var(--ink3);
  padding:10px 0 0;line-height:1.3;
}
.timeline-line{
  display:flex;flex-direction:column;align-items:center;
  gap:0;position:relative;
}
.timeline-dot{
  width:16px;height:16px;border-radius:50%;
  flex-shrink:0;margin-top:8px;border:2px solid var(--white);
  box-shadow:0 0 0 2px var(--dot-color,var(--border));
  background:var(--dot-color,var(--border));
}
.timeline-connector{flex:1;width:2px;background:var(--border);min-height:24px}
.timeline-content{
  padding:8px 12px 16px 0;
}
.timeline-phase{
  font-size:10px;font-weight:500;letter-spacing:.06em;
  text-transform:uppercase;color:var(--phase-color,var(--ink3));
  margin-bottom:2px;
}
.timeline-task{font-size:12.5px;color:var(--ink);margin-bottom:2px}
.timeline-resp{
  font-size:10.5px;padding:1px 7px;border-radius:8px;
  display:inline-block;
}

/* TABS */
.tabs{display:flex;gap:2px;background:var(--cream3);padding:3px;border-radius:6px;margin-bottom:20px;width:fit-content}
.tab{padding:6px 14px;border-radius:4px;cursor:pointer;font-size:12px;color:var(--ink3);transition:all .12s}
.tab.active{background:var(--white);color:var(--ink);font-weight:500;box-shadow:0 1px 4px rgba(0,0,0,.08)}

/* PROGRESS RING */
.ring-wrap{display:flex;flex-direction:column;align-items:center;gap:4px}
.ring-svg{transform:rotate(-90deg)}
.ring-bg{fill:none;stroke:var(--cream3);stroke-width:6}
.ring-fg{fill:none;stroke-width:6;stroke-linecap:round;transition:stroke-dashoffset .6s}
.ring-label{font-family:var(--ff-head);font-size:22px;font-weight:700;text-anchor:middle;dominant-baseline:middle}
.ring-sub{font-size:11px;color:var(--ink3);text-align:center}

/* URGENTE */
.urgente-banner{
  background:linear-gradient(135deg,var(--red) 0%,#7A1A1E 100%);
  border-radius:var(--radius);padding:14px 18px;
  display:flex;align-items:center;justify-content:space-between;
  margin-bottom:20px;
  color:white;
}
.urgente-banner h4{font-size:13px;font-weight:500;margin-bottom:2px}
.urgente-banner p{font-size:11px;opacity:.8}

/* PRINT */
@media print{
  .sidebar,.topbar,.tabs,.btn{display:none}
  .main{margin:0}
  .content{padding:0;max-width:100%}
}

/* SCROLLBAR */
::-webkit-scrollbar{width:5px}
::-webkit-scrollbar-track{background:var(--cream3)}
::-webkit-scrollbar-thumb{background:var(--gold);border-radius:3px}

.view{display:none}
.view.active{display:block}

/* Animações */
@keyframes fadeUp{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
.card,.kpi-card,.fase-card{animation:fadeUp .3s ease both}
</style>
</head>
<body>
<div class="shell">

<!-- SIDEBAR -->
<div class="sidebar">
  <div class="sidebar-brand">
    <span class="ori">Projeto Cultural</span>
    <h1>Caminhando<br>com Orí</h1>
    <p>3º Concurso Arte Preta · Santos</p>
  </div>

  <div class="nav-section">Navegação</div>
  <div class="nav-item active" onclick="showView('overview')"><div class="nav-dot"></div> Visão Geral</div>
  <div class="nav-item" onclick="showView('tarefas')"><div class="nav-dot"></div> Tarefas</div>
  <div class="nav-item" onclick="showView('financeiro')"><div class="nav-dot"></div> Financeiro & NFs</div>
  <div class="nav-item" onclick="showView('equipe')"><div class="nav-dot"></div> Equipe</div>
  <div class="nav-item" onclick="showView('distribuicao')"><div class="nav-dot"></div> Distribuição</div>
  <div class="nav-item" onclick="showView('relatorio')"><div class="nav-dot"></div> Relatório</div>
  <div class="nav-item" onclick="showView('atualizacoes')"><div class="nav-dot"></div> Atualizações ✦</div>

  <div class="sidebar-progress">
    <label><span>Progresso geral</span><span id="sb-pct">0%</span></label>
    <div class="sp-bar"><div class="sp-fill" id="sb-fill" style="width:0%"></div></div>
  </div>

  <div class="sidebar-footer">
    Decreto nº 10.614/2024<br>
    Proponente: Nicolle de Barros<br>
    85 dias de execução
  </div>
</div>

<!-- MAIN -->
<div class="main">

  <!-- TOPBAR -->
  <div class="topbar">
    <div class="topbar-left">
      <div>
        <div class="topbar-title" id="topbar-title">Visão Geral</div>
        <div class="topbar-sub" id="topbar-date"></div>
      </div>
    </div>
    <div class="topbar-right">
      <span class="badge badge-gold" id="top-fase-badge">Mês 2 · Semana 4</span>
      <span class="badge badge-verde">R$ 5.800 em caixa</span>
      <button class="btn btn-dark btn-sm" onclick="showView('relatorio')">📄 Gerar Relatório</button>
    </div>
  </div>

  <!-- ══ VIEW: VISÃO GERAL ══ -->
  <div class="view active" id="view-overview">
  <div class="content">

    <!-- Urgente -->
    <div class="urgente-banner">
      <div>
        <h4>⚑ Prazo crítico — 18/03: Fechamento do arquivo para a gráfica</h4>
        <p>Confirmação do ISBN e envio obrigatórios até sexta-feira · 21/03: entrada em produção</p>
      </div>
      <span class="badge" style="background:rgba(255,255,255,.2);color:white;font-size:12px">5 dias</span>
    </div>

    <!-- KPIs -->
    <div class="kpi-grid">
      <div class="kpi-card" style="--kpi-color:var(--gold)" data-icon="💰">
        <div class="kpi-label">Orçamento total</div>
        <div class="kpi-value">R$ 20.000</div>
        <div class="kpi-sub">Aprovado · Decreto 10.614/2024</div>
      </div>
      <div class="kpi-card" style="--kpi-color:var(--azul)" data-icon="✓">
        <div class="kpi-label">Total pago</div>
        <div class="kpi-value" style="color:var(--azul)">R$ 8.025</div>
        <div class="kpi-sub">40% do orçamento realizado</div>
      </div>
      <div class="kpi-card" style="--kpi-color:var(--verde)" data-icon="🏦">
        <div class="kpi-label">Saldo em caixa</div>
        <div class="kpi-value" style="color:var(--verde)">R$ 5.800</div>
        <div class="kpi-sub">Atualizado hoje · 13/03/2026</div>
      </div>
      <div class="kpi-card" style="--kpi-color:var(--terra)" data-icon="📚">
        <div class="kpi-label">Tiragem prevista</div>
        <div class="kpi-value" style="color:var(--terra)">100 livros</div>
        <div class="kpi-sub">30 gratuitos · 3 pontos de distribuição</div>
      </div>
    </div>

    <!-- Fases -->
    <div class="section-title">Fases do Projeto</div>
    <div class="fases-row">
      <div class="fase-card" style="--fase-color:#1A4A7A" onclick="showView('tarefas')">
        <div class="fase-num">1</div>
        <div class="fase-name">Pré-Produção</div>
        <div class="fase-period">Fev/2026 · Semanas 1–3</div>
        <div class="fase-bar"><div class="fase-bar-fill" style="width:100%"></div></div>
        <div class="fase-pct">100% <span class="badge badge-verde" style="font-size:9px;padding:1px 6px">Concluído</span></div>
      </div>
      <div class="fase-card active" style="--fase-color:var(--verde)" onclick="showView('tarefas')">
        <div class="fase-num">2</div>
        <div class="fase-name">Produção</div>
        <div class="fase-period">Mar/2026 · Semanas 4–7</div>
        <div class="fase-bar"><div class="fase-bar-fill" id="fase2-bar" style="width:25%"></div></div>
        <div class="fase-pct" id="fase2-pct">25% <span class="badge badge-gold" style="font-size:9px;padding:1px 6px">Em andamento</span></div>
      </div>
      <div class="fase-card" style="--fase-color:#5A3A7A" onclick="showView('tarefas')">
        <div class="fase-num">3</div>
        <div class="fase-name">Divulgação</div>
        <div class="fase-period">Abr/2026 · Semanas 7–10</div>
        <div class="fase-bar"><div class="fase-bar-fill" id="fase3-bar" style="width:5%"></div></div>
        <div class="fase-pct" id="fase3-pct">5% <span class="badge badge-azul" style="font-size:9px;padding:1px 6px">Iniciado</span></div>
      </div>
      <div class="fase-card" style="--fase-color:var(--gold)" onclick="showView('tarefas')">
        <div class="fase-num">4</div>
        <div class="fase-name">Lançamento</div>
        <div class="fase-period">Mai/2026 · Semanas 11–12</div>
        <div class="fase-bar"><div class="fase-bar-fill" style="width:0%"></div></div>
        <div class="fase-pct">0% <span class="badge" style="background:var(--cream3);color:var(--ink3);font-size:9px;padding:1px 6px">Pendente</span></div>
      </div>
    </div>

    <!-- Progress + Timeline -->
    <div class="two-col">
      <!-- Progresso geral -->
      <div class="card">
        <div class="section-title" style="font-size:15px">Progresso Geral</div>
        <div style="display:flex;gap:24px;align-items:center">
          <div class="ring-wrap">
            <svg class="ring-svg" width="100" height="100" viewBox="0 0 100 100">
              <circle class="ring-bg" cx="50" cy="50" r="40"/>
              <circle class="ring-fg" cx="50" cy="50" r="40" id="ring-circle"
                stroke="var(--gold)"
                stroke-dasharray="251.2"
                stroke-dashoffset="251.2"/>
              <text class="ring-label" x="50" y="50" fill="var(--ink)" font-family="Playfair Display,serif" font-size="18" font-weight="700" transform="rotate(90,50,50)">
                <tspan id="ring-pct">0%</tspan>
              </text>
            </svg>
            <div class="ring-sub">tarefas concluídas</div>
          </div>
          <div style="flex:1">
            <div id="overview-fase-bars"></div>
          </div>
        </div>
      </div>

      <!-- Próximas atividades -->
      <div class="card">
        <div class="section-title" style="font-size:15px">Próximas Atividades</div>
        <div id="proximas-list" style="display:flex;flex-direction:column;gap:6px"></div>
      </div>
    </div>

    <!-- Marcadores importantes -->
    <div class="card one-col">
      <div class="section-title" style="font-size:15px">Marcos Críticos</div>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px" id="marcos-grid"></div>
    </div>

  </div>
  </div>

  <!-- ══ VIEW: TAREFAS ══ -->
  <div class="view" id="view-tarefas">
  <div class="content">
    <div class="section-title">
      Plano de Tarefas
      <div style="display:flex;gap:8px">
        <button class="btn btn-ghost btn-sm" onclick="expandAll()">Expandir tudo</button>
        <button class="btn btn-ghost btn-sm" onclick="collapseAll()">Recolher tudo</button>
      </div>
    </div>
    <div id="tarefas-container"></div>
  </div>
  </div>

  <!-- ══ VIEW: FINANCEIRO ══ -->
  <div class="view" id="view-financeiro">
  <div class="content">

    <div class="kpi-grid" style="grid-template-columns:repeat(3,1fr)">
      <div class="kpi-card" style="--kpi-color:var(--night)" data-icon="📊">
        <div class="kpi-label">Orçamento total</div>
        <div class="kpi-value">R$ 20.000</div>
        <div class="kpi-sub">Concurso Arte Preta 2024</div>
      </div>
      <div class="kpi-card" style="--kpi-color:var(--verde)" data-icon="✅">
        <div class="kpi-label">Pago / realizado</div>
        <div class="kpi-value" style="color:var(--verde)">R$ 8.025</div>
        <div class="kpi-sub" id="fin-pago-pct"></div>
      </div>
      <div class="kpi-card" style="--kpi-color:var(--gold)" data-icon="🏦">
        <div class="kpi-label">Saldo em caixa</div>
        <div class="kpi-value" style="color:var(--gold)">R$ 5.800</div>
        <div class="kpi-sub">A desembolsar: R$ 11.975</div>
      </div>
    </div>

    <div class="card one-col">
      <div class="section-title" style="font-size:15px">
        Checklist de Saídas × Notas Fiscais
        <span style="font-size:11px;font-weight:400;color:var(--ink3)" id="nf-summary"></span>
      </div>
      <table class="fin-table" id="fin-table-el"></table>
    </div>

    <div class="card" style="margin-top:14px;background:var(--cream);border-color:var(--red);border-left:4px solid var(--red)">
      <p style="font-size:12px;color:var(--red);font-weight:500">⚠ Lembrete prestação de contas</p>
      <p style="font-size:12px;color:var(--ink2);margin-top:4px">Toda saída deve ter NF, RPA ou recibo correspondente. Guardar comprovante de pagamento (PIX/TED/boleto) junto ao documento fiscal.</p>
    </div>
  </div>
  </div>

  <!-- ══ VIEW: EQUIPE ══ -->
  <div class="view" id="view-equipe">
  <div class="content">
    <div class="section-title">Equipe Técnica</div>
    <div class="equipe-grid" id="equipe-grid"></div>
  </div>
  </div>

  <!-- ══ VIEW: DISTRIBUIÇÃO ══ -->
  <div class="view" id="view-distribuicao">
  <div class="content">
    <div class="section-title">Distribuição Gratuita — Contrapartida do Edital</div>
    <div class="card" style="margin-bottom:16px;background:var(--gold-lt);border-color:var(--gold-md)">
      <p style="font-size:12.5px;color:var(--ink2)">O edital exige distribuição de <strong>30% da tiragem = 30 livros</strong> em 3 pontos estratégicos de Santos para cumprimento da contrapartida. Cada encontro deve ter lista de presença e registro fotográfico.</p>
    </div>
    <div id="dist-container"></div>
    <div class="card" style="margin-top:14px">
      <div class="section-title" style="font-size:15px">Formatos de distribuição</div>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:4px">
        <div style="text-align:center;padding:16px;background:var(--cream2);border-radius:var(--radius-sm)">
          <div style="font-size:22px;margin-bottom:6px">📖</div>
          <div style="font-size:12px;font-weight:500">Livro Físico</div>
          <div style="font-size:11px;color:var(--ink3)">10×15cm · 62 páginas<br>100 exemplares</div>
        </div>
        <div style="text-align:center;padding:16px;background:var(--cream2);border-radius:var(--radius-sm)">
          <div style="font-size:22px;margin-bottom:6px">🎧</div>
          <div style="font-size:12px;font-weight:500">Áudio Livro</div>
          <div style="font-size:11px;color:var(--ink3)">Medida de acessibilidade<br>R$ 1.200 alocados</div>
        </div>
        <div style="text-align:center;padding:16px;background:var(--cream2);border-radius:var(--radius-sm)">
          <div style="font-size:22px;margin-bottom:6px">📄</div>
          <div style="font-size:12px;font-weight:500">PDF Digital</div>
          <div style="font-size:11px;color:var(--ink3)">Distribuição online<br>Acesso ampliado</div>
        </div>
      </div>
    </div>
  </div>
  </div>

  <!-- ══ VIEW: RELATÓRIO ══ -->
  <div class="view" id="view-relatorio">
  <div class="content">
    <div class="section-title">Relatório de Execução</div>
    <div class="card" style="margin-bottom:16px">
      <div style="margin-bottom:14px">
        <div class="tabs" id="rel-tabs">
          <div class="tab active" onclick="setRelTipo('parcial')">Relatório Parcial</div>
          <div class="tab" onclick="setRelTipo('final')">Relatório Final</div>
          <div class="tab" onclick="setRelTipo('reuniao')">Ata de Reunião</div>
        </div>
      </div>
      <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
        <button class="btn btn-gold" onclick="gerarRelatorio()">📄 Gerar Relatório</button>
        <button class="btn btn-ghost btn-sm" onclick="copiarRelatorio()">📋 Copiar texto</button>
        <button class="btn btn-ghost btn-sm" onclick="imprimirRelatorio()">🖨 Imprimir</button>
        <span style="font-size:11px;color:var(--ink3)" id="rel-hint">Selecione o tipo e clique em Gerar</span>
      </div>
    </div>
    <div class="card">
      <pre id="relatorio-output" style="display:block;background:var(--cream);border:1px solid var(--border);border-radius:8px;padding:20px;font-size:12px;line-height:1.8;white-space:pre-wrap;font-family:Georgia,serif;max-height:600px;overflow-y:auto;color:var(--ink)">Clique em "Gerar Relatório" para produzir o documento.</pre>
    </div>
  </div>
  </div>

  <!-- ══ VIEW: ATUALIZAÇÕES ══ -->
  <div class="view" id="view-atualizacoes">
  <div class="content">

    <!-- Formulário de nova atualização -->
    <div class="card" style="margin-bottom:20px;border-top:3px solid var(--gold)">
      <div class="section-title" style="font-size:16px;margin-bottom:16px">Nova Atualização</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px">
        <div>
          <label style="font-size:11px;font-weight:500;color:var(--ink3);display:block;margin-bottom:5px;text-transform:uppercase;letter-spacing:.05em">Data</label>
          <input type="date" id="upd-data" style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:var(--radius-sm);font-family:var(--ff-body);font-size:13.5px;background:var(--cream);color:var(--ink);outline:none">
        </div>
        <div>
          <label style="font-size:11px;font-weight:500;color:var(--ink3);display:block;margin-bottom:5px;text-transform:uppercase;letter-spacing:.05em">Responsável</label>
          <select id="upd-resp" style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:var(--radius-sm);font-family:var(--ff-body);font-size:13.5px;background:var(--cream);color:var(--ink);outline:none">
            <option value="Equipe">Toda a equipe</option>
            <option value="Nicolle">Nicolle (Tormenta)</option>
            <option value="Suelen">Suelen Bomfim</option>
            <option value="Jessika">Jéssika Chendi</option>
            <option value="Joao">João Pedro</option>
          </select>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px">
        <div>
          <label style="font-size:11px;font-weight:500;color:var(--ink3);display:block;margin-bottom:5px;text-transform:uppercase;letter-spacing:.05em">Categoria</label>
          <select id="upd-cat" style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:var(--radius-sm);font-family:var(--ff-body);font-size:13.5px;background:var(--cream);color:var(--ink);outline:none">
            <option value="Producao">Produção</option>
            <option value="Financeiro">Financeiro</option>
            <option value="Divulgacao">Divulgação</option>
            <option value="Reuniao">Reunião de equipe</option>
            <option value="Grafica">Gráfica / Impressão</option>
            <option value="Distribuicao">Distribuição</option>
            <option value="Lancamento">Lançamento</option>
            <option value="Administrativo">Administrativo / Edital</option>
            <option value="Outro">Outro</option>
          </select>
        </div>
        <div>
          <label style="font-size:11px;font-weight:500;color:var(--ink3);display:block;margin-bottom:5px;text-transform:uppercase;letter-spacing:.05em">Tipo</label>
          <select id="upd-tipo" style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:var(--radius-sm);font-family:var(--ff-body);font-size:13.5px;background:var(--cream);color:var(--ink);outline:none">
            <option value="info">ℹ Informação / Progresso</option>
            <option value="ok">✓ Tarefa concluída</option>
            <option value="alerta">⚑ Alerta / Atenção</option>
            <option value="financeiro">R$ Movimentação financeira</option>
            <option value="reuniao">◎ Decisão de reunião</option>
            <option value="problema">✕ Problema / Bloqueio</option>
          </select>
        </div>
      </div>
      <div style="margin-bottom:14px">
        <label style="font-size:11px;font-weight:500;color:var(--ink3);display:block;margin-bottom:5px;text-transform:uppercase;letter-spacing:.05em">Título da atualização</label>
        <input type="text" id="upd-titulo" placeholder="Ex: ISBN recebido e inserido no arquivo final" style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:var(--radius-sm);font-family:var(--ff-body);font-size:13.5px;background:var(--cream);color:var(--ink);outline:none">
      </div>
      <div style="margin-bottom:14px">
        <label style="font-size:11px;font-weight:500;color:var(--ink3);display:block;margin-bottom:5px;text-transform:uppercase;letter-spacing:.05em">Descrição detalhada</label>
        <textarea id="upd-desc" rows="4" placeholder="Descreva a atualização com detalhes — o que foi feito, por quem, próximos passos, observações importantes..." style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:var(--radius-sm);font-family:var(--ff-body);font-size:13.5px;background:var(--cream);color:var(--ink);outline:none;resize:vertical;line-height:1.6"></textarea>
      </div>
      <div style="display:flex;gap:10px;align-items:center">
        <button class="btn btn-gold" onclick="salvarAtualizacao()">+ Registrar atualização</button>
        <button class="btn btn-ghost btn-sm" onclick="limparFormulario()">Limpar</button>
        <span id="upd-feedback" style="font-size:11.5px;color:var(--verde);font-weight:500"></span>
      </div>
    </div>

    <!-- Filtros e busca -->
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;flex-wrap:wrap;gap:10px">
      <div class="section-title" style="margin-bottom:0;border:none;padding:0;font-size:16px">Histórico de Atualizações <span id="upd-count" style="font-size:12px;font-weight:400;color:var(--ink3)"></span></div>
      <div style="display:flex;gap:8px;align-items:center">
        <input type="text" id="upd-busca" placeholder="Buscar..." oninput="renderAtualizacoes()" style="padding:7px 12px;border:1px solid var(--border);border-radius:var(--radius-sm);font-size:12.5px;font-family:var(--ff-body);background:var(--cream);color:var(--ink);outline:none;width:160px">
        <select id="upd-filtro-cat" onchange="renderAtualizacoes()" style="padding:7px 10px;border:1px solid var(--border);border-radius:var(--radius-sm);font-size:12px;font-family:var(--ff-body);background:var(--cream);color:var(--ink);outline:none">
          <option value="">Todas as categorias</option>
          <option value="Producao">Produção</option>
          <option value="Financeiro">Financeiro</option>
          <option value="Divulgacao">Divulgação</option>
          <option value="Reuniao">Reunião</option>
          <option value="Grafica">Gráfica</option>
          <option value="Distribuicao">Distribuição</option>
          <option value="Lancamento">Lançamento</option>
          <option value="Administrativo">Administrativo</option>
        </select>
        <button class="btn btn-ghost btn-sm" onclick="exportarAtualizacoes()">⬇ Exportar</button>
      </div>
    </div>

    <!-- Lista de atualizações -->
    <div id="upd-lista"></div>

  </div>
  </div>

</div><!-- /main -->
</div><!-- /shell -->

<script>
// ─── DADOS DO PROJETO ─────────────────────────────────────────────────

const MEMBROS = {
  Nicolle: { color:"#1A4A7A", bg:"#EBF3FB", icon:"N", papel:"Gestão Adm. · Autora" },
  Suelen:  { color:"#5A3A7A", bg:"#F3EEF9", icon:"S", papel:"Ilustradora · Designer" },
  Jessika: { color:"#A67C00", bg:"#FDF3DC", icon:"J", papel:"Produção Executiva Cultural" },
  Joao:    { color:"#1A5C38", bg:"#E3F2E9", icon:"JP", papel:"Produção Técnica · Designer" },
  Equipe:  { color:"#5C4A28", bg:"#F5EFE2", icon:"E", papel:"Toda a equipe" },
  Grafica: { color:"#777",    bg:"#F5F5F5", icon:"G", papel:"Fornecedor externo" },
};

const FASES_COLORS = {
  "Pre-producao": "#1A4A7A",
  "Producao":     "#1A5C38",
  "Divulgacao":   "#5A3A7A",
  "Lancamento":   "#C8871A",
  "Pos-producao": "#777",
};

const TAREFAS = [
  { fase:"Pre-producao", cor:"#1A4A7A", periodo:"Fev/2026 · Sem. 1–3", items:[
    { id:"p1",  text:"Reunião geral de equipe: alinhamento, definição de papeis e contatos com fornecedores", resp:"Equipe",  done:true },
    { id:"p2",  text:"Criação do material de divulgação (artes, posts, identidade visual da campanha)",       resp:"Suelen",  done:true },
    { id:"p3",  text:"Finalização do livro: revisão do texto, diagramação e correções",                      resp:"Nicolle", done:true },
    { id:"p4",  text:"Ilustrações do livro: arte final de todas as páginas",                                 resp:"Suelen",  done:true },
    { id:"p5",  text:"Aprovação do projeto gráfico definitivo (capa e miolo)",                               resp:"Equipe",  done:true },
    { id:"p6",  text:"Pesquisa e fechamento de orçamentos com gráficas (mínimo 3 cotações)",                 resp:"Nicolle", done:true },
    { id:"p7",  text:"Pagamento da guia do ISBN — registro na Biblioteca Nacional",                          resp:"Nicolle", done:true },
  ]},
  { fase:"Producao", cor:"#1A5C38", periodo:"Mar/2026 · Sem. 4–7", items:[
    { id:"pr1", text:"✓ HOJE: Aprovação do planejamento de divulgação — marco do projeto",                   resp:"Equipe",  done:true },
    { id:"pr2", text:"Confirmação e inserção do número ISBN no arquivo final do livro",                       resp:"Nicolle", done:false },
    { id:"pr3", text:"Revisão técnica final do arquivo: sangria, resolução, fontes e ISBN",                  resp:"Suelen",  done:false },
    { id:"pr4", text:"Início das gravações do áudio livro (acessibilidade)",                                  resp:"Nicolle", done:false },
    { id:"pr5", text:"Lançamento das ações de divulgação: redes sociais, stories, reels",                    resp:"Joao",    done:false },
    { id:"pr6", text:"PRAZO 18/03: Fechamento definitivo do arquivo e envio para a gráfica",                 resp:"Suelen",  done:false },
    { id:"pr7", text:"Aprovação da prova / blueline com a gráfica",                                          resp:"Nicolle", done:false },
    { id:"pr8", text:"PRAZO CRÍTICO 21/03: Confirmação de entrada em produção na gráfica",                   resp:"Nicolle", done:false },
    { id:"pr9", text:"Produção fonográfica do áudio livro: gravação e edição completa",                      resp:"Nicolle", done:false },
    { id:"pr10",text:"Impressão dos livros (~10 dias úteis) — acompanhar com a gráfica",                     resp:"Grafica", done:false },
    { id:"pr11",text:"Retirada dos exemplares + conferência da tiragem (100 livros)",                        resp:"Nicolle", done:false },
    { id:"pr12",text:"Edição final do áudio livro + legenda de materiais midiáticos",                        resp:"Joao",    done:false },
    { id:"pr13",text:"Produção das Zines (distribuídas gratuitamente junto aos livros)",                     resp:"Suelen",  done:false },
  ]},
  { fase:"Divulgacao", cor:"#5A3A7A", periodo:"Abr/2026 · Sem. 7–10", items:[
    { id:"d1",  text:"Divulgação ativa: redes sociais, imprensa local, parceiros culturais",                  resp:"Joao",    done:false },
    { id:"d2",  text:"Definição e confirmação da data, horário e local do evento de lançamento",              resp:"Equipe",  done:false },
    { id:"d3",  text:"Produção do evento: logística, som, projetores, alimentação, comunicadores",            resp:"Jessika", done:false },
    { id:"d4",  text:"Seleção e preparo dos 30 exemplares gratuitos para distribuição nos 3 pontos",         resp:"Nicolle", done:false },
    { id:"d5",  text:"Mobilização das comunidades alvo: Saboó, Vila Gilda e Vila Nova-Paquetá",              resp:"Jessika", done:false },
  ]},
  { fase:"Lancamento", cor:"#C8871A", periodo:"Mai/2026 · Sem. 11–12", items:[
    { id:"l1",  text:"Evento de lançamento oficial: abertura, apresentações artísticas, assinatura de livros",resp:"Equipe",  done:false },
    { id:"l2",  text:"1º encontro: distribuição gratuita — Morro do Saboó (10 livros + Zines)",             resp:"Jessika", done:false },
    { id:"l3",  text:"2º encontro: distribuição gratuita — Vila Gilda / Zona Noroeste (10 livros + Zines)", resp:"Jessika", done:false },
    { id:"l4",  text:"3º encontro: distribuição gratuita — Vila Nova-Paquetá (10 livros + Zines)",          resp:"Jessika", done:false },
    { id:"l5",  text:"Coleta de registros finais: fotos, listas de presença, depoimentos",                   resp:"Joao",    done:false },
    { id:"l6",  text:"Elaboração do relatório final de execução do projeto",                                  resp:"Nicolle", done:false },
    { id:"l7",  text:"Organização e envio da prestação de contas ao 3º Concurso de Arte Preta",              resp:"Nicolle", done:false },
  ]},
];

const FINANCEIRO = [
  { desc:"Equipe técnica — ajudas de custo pagas",         prev:"R$ 8.025,00", real:"R$ 8.025,00", tipo:"RPA/Recibo",   status:"pago",    nfPago:true,  nfArq:false },
  { desc:"Guia ISBN — taxa de registro",                   prev:"—",           real:"Pago",         tipo:"Guia/Boleto",  status:"pago",    nfPago:true,  nfArq:false },
  { desc:"Prestações de serviço restantes — equipe",       prev:"R$ 3.900,00", real:"—",            tipo:"RPA/NF",       status:"pendente",nfPago:false, nfArq:false },
  { desc:"Ajuda de custo — gravação áudio livro",          prev:"R$ 400,00",   real:"—",            tipo:"Recibo",       status:"pendente",nfPago:false, nfArq:false },
  { desc:"Materiais para realização do mural",             prev:"R$ 500,00",   real:"—",            tipo:"NF/Cupom",     status:"pendente",nfPago:false, nfArq:false },
  { desc:"Materiais gráficos de divulgação",               prev:"R$ 500,00",   real:"—",            tipo:"NF",           status:"pendente",nfPago:false, nfArq:false },

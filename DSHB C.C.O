  { desc:"Produção do áudio livro (acessibilidade)",       prev:"R$ 1.200,00", real:"—",            tipo:"NF/Contrato",  status:"pendente",nfPago:false, nfArq:false },
  { desc:"Registros dos processos / direitos autorais",    prev:"R$ 1.500,00", real:"—",            tipo:"Recibo/NF",    status:"pendente",nfPago:false, nfArq:false },

  { desc:"Alimentação do evento de lançamento",            prev:"R$ 400,00",   real:"—",            tipo:"NF/Cupom",     status:"pendente",nfPago:false, nfArq:false },
  { desc:"Reserva de contingência",                        prev:"R$ 700,00",   real:"—",            tipo:"A definir",    status:"definir", nfPago:false, nfArq:false },
];

const DISTRIBUICAO = [
  { ponto:"Ponto 1", local:"Morro do Saboó",            bairro:"Zona Noroeste", livros:10, done:false },
  { ponto:"Ponto 2", local:"Vila Gilda",                 bairro:"Zona Noroeste", livros:10, done:false },
  { ponto:"Ponto 3", local:"Vila Nova-Paquetá",          bairro:"Zona Central",  livros:10, done:false },
];

const EQUIPE_DETALHES = [
  { nome:"Nicolle", apelido:"Tormenta", papel:"Gestão Administrativa · Autora",
    bio:"Cria da Zona Noroeste, escritora, performer, MC e produtora cultural. Gestão do projeto, texto do livro, relação com o edital e prestação de contas.",
    entregas:"Texto do livro · ISBN · Gestão financeira · Prestação de contas · Supervisão geral" },
  { nome:"Suelen", apelido:"Suelen Bomfim", papel:"Ilustradora · Designer Gráfica",
    bio:"Designer com 4 anos de experiência. MEI - Suelen Design e Media. Responsável pela identidade visual do projeto.",
    entregas:"Ilustrações do livro · Diagramação · Capa · Materiais gráficos · Zines" },
  { nome:"Jessika", apelido:"Jéssika Chendi", papel:"Produção Executiva Cultural",
    bio:"Multiartista, arte educadora e pesquisadora. Especialização em acessibilidade cultural pela ESCULT.",
    entregas:"Produção dos 3 encontros de distribuição · Logística do evento · Relatório final" },
  { nome:"Joao", apelido:"João Pedro", papel:"Produção Técnica · Designer",
    bio:"Produtor executivo autônomo, músico e videomaker. Atuou no LAB Procomum e evento internacional SulxSouth.",
    entregas:"Registros audiovisuais · Edição do áudio livro · Divulgação digital · Documentação" },
];

const PROXIMAS = [
  { data:"13–14/03", urgente:true,  text:"Confirmar recebimento do ISBN e inserir no arquivo final", resp:"Nicolle" },
  { data:"14–17/03", urgente:true,  text:"Revisão técnica final do arquivo antes do fechamento",     resp:"Suelen" },
  { data:"18/03",    urgente:true,  text:"PRAZO: Fechamento e envio para a gráfica",                  resp:"Suelen" },
  { data:"17–18/03", urgente:false, text:"Início das gravações do áudio livro",                       resp:"Nicolle" },
  { data:"13–17/03", urgente:false, text:"Lançamento da campanha de divulgação nas redes",            resp:"Joao" },
  { data:"21/03",    urgente:true,  text:"Confirmação de entrada em produção na gráfica",             resp:"Nicolle" },
];

const MARCOS = [
  { data:"18/03", label:"Fechamento do arquivo", urgente:true },
  { data:"21/03", label:"Entrada em produção",   urgente:true },
  { data:"07/04", label:"Retirada dos livros",   urgente:false },
  { data:"Abr",   label:"Evento de lançamento",  urgente:false },
  { data:"Mai",   label:"3 encontros comunidade",urgente:false },
  { data:"Mai",   label:"Prestação de contas",   urgente:false },
];

// ─── STATE ───────────────────────────────────────────────────────────
let state = {
  tarefas: {},
  nfPago:  {},
  nfArq:   {},
  relTipo: "parcial",
  openFases: new Set(["Producao"]),
};

// Inicializar com dados das tarefas
TAREFAS.forEach(fase => fase.items.forEach(t => {
  state.tarefas[t.id] = t.done;
}));
FINANCEIRO.forEach((f,i) => {
  state.nfPago[i] = f.nfPago;
  state.nfArq[i]  = f.nfArq;
});

// ─── CÁLCULOS ─────────────────────────────────────────────────────────
function calcProgress() {
  let total=0,done=0;
  TAREFAS.forEach(fase => fase.items.forEach(t => {
    total++;
    if(state.tarefas[t.id]) done++;
  }));
  return { total, done, pct: total ? Math.round(done/total*100) : 0 };
}

function calcFaseProgress(faseNome) {
  const fase = TAREFAS.find(f=>f.fase===faseNome);
  if(!fase) return 0;
  const done = fase.items.filter(t=>state.tarefas[t.id]).length;
  return Math.round(done/fase.items.length*100);
}

// ─── RENDER FUNCTIONS ─────────────────────────────────────────────────

function renderTarefas() {
  const c = document.getElementById('tarefas-container');
  c.innerHTML = '';
  TAREFAS.forEach(fase => {
    const done  = fase.items.filter(t=>state.tarefas[t.id]).length;
    const total = fase.items.length;
    const pct   = Math.round(done/total*100);
    const isOpen = state.openFases.has(fase.fase);

    const wrap = document.createElement('div');
    wrap.className = 'tarefa-grupo';
    wrap.innerHTML = `
      <div class="tarefa-fase-hdr ${isOpen?'open':''}" onclick="toggleFase('${fase.fase}')">
        <div class="tarefa-fase-title">
          <div class="tarefa-fase-dot" style="background:${fase.cor}"></div>
          ${fase.fase.replace('-',' ')} <span style="font-size:11px;color:var(--ink3);font-weight:400">${fase.periodo}</span>
        </div>
        <div style="display:flex;align-items:center;gap:10px">
          <div style="font-size:11px;color:var(--ink3)">${done}/${total} · ${pct}%</div>
          <div style="width:60px;height:4px;background:var(--cream3);border-radius:2px;overflow:hidden">
            <div style="height:100%;width:${pct}%;background:${fase.cor};border-radius:2px"></div>
          </div>
          <span style="color:var(--ink3);font-size:11px">${isOpen?'▲':'▼'}</span>
        </div>
      </div>
      <div class="tarefa-list ${isOpen?'open':''}" id="lista-${fase.fase}">
        ${fase.items.map(t => {
          const isDone = state.tarefas[t.id];
          const mc = MEMBROS[t.resp] || MEMBROS.Equipe;
          return `
            <div class="tarefa-item ${isDone?'done':''}">
              <div class="tarefa-cb ${isDone?'done':''}" onclick="toggleTarefa('${t.id}')">${isDone?'✓':''}</div>
              <div class="tarefa-text">${t.text}</div>
              <span class="tarefa-resp" style="background:${mc.bg};color:${mc.color}">${t.resp}</span>
            </div>
          `;
        }).join('')}
      </div>
    `;
    c.appendChild(wrap);
  });
}

function renderFinanceiro() {
  const tbl = document.getElementById('fin-table-el');
  let nfDone = Object.values(state.nfArq).filter(Boolean).length;
  const sumEl = document.getElementById('nf-summary');
  if(sumEl) sumEl.textContent = `${nfDone}/${FINANCEIRO.length} NFs arquivadas`;

  tbl.innerHTML = `
    <thead>
      <tr>
        <th style="width:30px">OK</th>
        <th>Descrição</th>
        <th>Previsto</th>
        <th>Realizado</th>
        <th>Tipo doc.</th>
        <th>Pago</th>
        <th>NF/Rec.</th>
        <th>Situação</th>
      </tr>
    </thead>
    <tbody>
      ${FINANCEIRO.map((f,i)=>`
        <tr class="${f.status==='pago'?'pago':''}">
          <td style="text-align:center">
            <div class="nf-cb ${state.nfArq[i]?'done':''}" onclick="toggleNfArq(${i})">
              ${state.nfArq[i]?'✓':''}
            </div>
          </td>
          <td>${f.desc}</td>
          <td style="text-align:right;font-weight:500">${f.prev}</td>
          <td style="text-align:right;color:${f.real!=='—'?'var(--verde)':'var(--ink3)'}">${f.real}</td>
          <td style="color:var(--azul);font-size:11px">${f.tipo}</td>
          <td style="text-align:center">
            <div class="nf-cb ${state.nfPago[i]?'done':''}" onclick="toggleNfPago(${i})">
              ${state.nfPago[i]?'✓':''}
            </div>
          </td>
          <td style="text-align:center">
            <div class="nf-cb ${state.nfArq[i]?'done':''}" onclick="toggleNfArq(${i})">
              ${state.nfArq[i]?'✓':''}
            </div>
          </td>
          <td style="text-align:center">
            <span class="fin-status ${f.status}">
              ${f.status==='pago'?'PAGO':f.status==='pendente'?'PENDENTE':'A DEFINIR'}
            </span>
          </td>
        </tr>
      `).join('')}
    </tbody>
  `;

  const ppct = document.getElementById('fin-pago-pct');
  if(ppct) ppct.textContent = '40% do orçamento executado';
}

function renderEquipe() {
  const grid = document.getElementById('equipe-grid');
  if(!grid) return;
  grid.innerHTML = EQUIPE_DETALHES.map(m => {
    const mc = MEMBROS[m.nome];
    const fasesDone = TAREFAS.flatMap(f=>f.items).filter(t=>t.resp===m.nome&&state.tarefas[t.id]).length;
    const fasesTotal = TAREFAS.flatMap(f=>f.items).filter(t=>t.resp===m.nome).length;
    return `
      <div class="membro-card">
        <div class="membro-top">
          <div class="avatar" style="background:${mc.bg};color:${mc.color}">${mc.icon}</div>
          <div>
            <div class="membro-name">${m.apelido}</div>
            <div class="membro-role">${m.papel}</div>
          </div>
        </div>
        <div style="margin-bottom:8px">
          <div style="display:flex;justify-content:space-between;font-size:10px;color:var(--ink3);margin-bottom:4px">
            <span>Tarefas</span><span>${fasesDone}/${fasesTotal}</span>
          </div>
          <div style="height:4px;background:var(--cream3);border-radius:2px;overflow:hidden">
            <div style="height:100%;width:${fasesTotal?Math.round(fasesDone/fasesTotal*100):0}%;background:${mc.color};border-radius:2px"></div>
          </div>
        </div>
        <div class="membro-tasks"><strong style="font-size:11px;color:var(--ink3)">ENTREGAS:</strong><br>${m.entregas}</div>
      </div>
    `;
  }).join('');
}

function renderDistribuicao() {
  const c = document.getElementById('dist-container');
  if(!c) return;
  c.innerHTML = DISTRIBUICAO.map((d,i) => `
    <div class="dist-card">
      <div class="dist-top">
        <div>
          <div class="dist-name">${d.ponto} — ${d.local}</div>
          <div class="dist-meta">${d.bairro} · ${d.livros} livros + Zines · Responsável: Jéssika Chendi</div>
        </div>
        <div style="display:flex;align-items:center;gap:10px">
          <span class="badge ${d.done?'badge-verde':'badge-gold'}">${d.done?'Realizado':'Pendente'}</span>
          <div class="nf-cb ${d.done?'done':''}" onclick="toggleDist(${i})" style="width:20px;height:20px;font-size:12px">
            ${d.done?'✓':''}
          </div>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:10px;font-size:11px">
        <div style="background:var(--cream2);padding:8px;border-radius:4px">
          <div style="color:var(--ink3)">Data</div>
          <div style="font-weight:500">A definir</div>
        </div>
        <div style="background:var(--cream2);padding:8px;border-radius:4px">
          <div style="color:var(--ink3)">Lista de presença</div>
          <div style="font-weight:500">${d.done?'Coletada':'Pendente'}</div>
        </div>
        <div style="background:var(--cream2);padding:8px;border-radius:4px">
          <div style="color:var(--ink3)">Registro fotográfico</div>
          <div style="font-weight:500">${d.done?'Realizado':'Pendente'}</div>
        </div>
      </div>
    </div>
  `).join('');
}

function renderOverview() {
  const prog = calcProgress();

  // Ring
  const circ = 2 * Math.PI * 40;
  const offset = circ - (prog.pct/100)*circ;
  const ring = document.getElementById('ring-circle');
  const rpct = document.getElementById('ring-pct');
  if(ring){ ring.style.strokeDashoffset = offset; }
  if(rpct){ rpct.textContent = prog.pct+'%'; }

  // Sidebar
  const sbFill = document.getElementById('sb-fill');
  const sbPct  = document.getElementById('sb-pct');
  if(sbFill) sbFill.style.width = prog.pct+'%';
  if(sbPct)  sbPct.textContent  = prog.pct+'%';

  // Fase bars
  const fbars = document.getElementById('overview-fase-bars');
  if(fbars) {
    fbars.innerHTML = TAREFAS.map(f=>{
      const p = calcFaseProgress(f.fase);
      return `
        <div style="margin-bottom:10px">
          <div style="display:flex;justify-content:space-between;font-size:11px;color:var(--ink3);margin-bottom:3px">
            <span>${f.fase.replace('-',' ')}</span><span>${p}%</span>
          </div>
          <div style="height:6px;background:var(--cream3);border-radius:3px;overflow:hidden">
            <div style="height:100%;width:${p}%;background:${f.cor};border-radius:3px;transition:width .4s"></div>
          </div>
        </div>
      `;
    }).join('');
  }

  // Proximas
  const pl = document.getElementById('proximas-list');
  if(pl) {
    pl.innerHTML = PROXIMAS.map(a=>`
      <div style="display:flex;gap:10px;align-items:flex-start;padding:7px 10px;background:${a.urgente?'var(--red-lt)':'var(--cream2)'};border-radius:6px;border-left:3px solid ${a.urgente?'var(--red)':'var(--border)'}">
        <span style="font-size:10px;font-weight:500;white-space:nowrap;color:${a.urgente?'var(--red)':'var(--ink3)'}">${a.data}</span>
        <div style="flex:1;font-size:12px;color:var(--ink)">${a.text}</div>
        <span style="font-size:10px;padding:1px 6px;border-radius:8px;background:${(MEMBROS[a.resp]||MEMBROS.Equipe).bg};color:${(MEMBROS[a.resp]||MEMBROS.Equipe).color};white-space:nowrap">${a.resp}</span>
      </div>
    `).join('');
  }

  // Marcos
  const mg = document.getElementById('marcos-grid');
  if(mg) {
    mg.innerHTML = MARCOS.map(m=>`
      <div style="padding:12px 14px;border-radius:8px;border:1px solid ${m.urgente?'var(--red)':'var(--border)'};background:${m.urgente?'var(--red-lt)':'var(--cream2)'}">
        <div style="font-size:13px;font-weight:700;font-family:var(--ff-head);color:${m.urgente?'var(--red)':'var(--ink)'};">${m.data}</div>
        <div style="font-size:12px;color:var(--ink2);margin-top:2px">${m.label}</div>
        ${m.urgente?`<span class="badge badge-red" style="margin-top:6px;font-size:10px;padding:2px 6px">Urgente</span>`:''}
      </div>
    `).join('');
  }
}

